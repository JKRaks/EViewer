{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Debug EViewer (Vite)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/src/*": "${webRoot}/src/*",
        "vite:///*": "${webRoot}/*",
        "webpack:///./src/*": "${webRoot}/src/*",
        "webpack:///src/*": "${webRoot}/src/*"
      }
    },
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Debug EViewer (Worker)",
      "url": "http://127.0.0.1:8787",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    }
  ]
}
