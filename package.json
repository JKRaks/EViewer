{
  "name": "jks-ehm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "deploy:cloudflare": "node deploy/cloudflare/release.mjs",
    "dev:worker": "wrangler dev --config wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:hentaiverse": "node --experimental-strip-types --test tests/hentaiverse-auto-battle.test.mjs",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "icons:generate": "node tool/generate-app-icons.mjs",
    "check:worker": "node --check proxy-server.workers.js && node --check worker-app.js"
  },
  "dependencies": {
    "@lucide/vue": "^1.59.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.4.15",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "~10.4.0",
    "jiti": "^2.5.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.1.0",
    "wrangler": "4.136.0"
  }
}
