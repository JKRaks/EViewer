{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eviewer-app",
  "main": "./worker-app.js",
  "compatibility_date": "2025-10-19",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": false,
  // Production custom domains are configured separately.
  "routes": [],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/ehentai",
      "/ehentai/*",
      "/exhentai",
      "/exhentai/*",
      "/auth/*",
      "/hentaiverse/*",
      "/image-proxy",
      "/health",
    ],
  },
  "vars": {
    "ALLOWED_AUTH_EXPORT_ORIGINS": "",
    "EVIEWER_PROXY_ENVIRONMENT": "production",
    "PROXY_LOG_LEVEL": "info",
  },
  "version_metadata": { "binding": "EVIEWER_VERSION" },
  "ratelimits": [
    { "name": "proxy-df", "namespace_id": "2", "simple": { "limit": 10, "period": 10 } },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.2,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
    "issues": { "enabled": true },
  },
  "previews": {
    "vars": {
      "ALLOWED_AUTH_EXPORT_ORIGINS": "",
      "EVIEWER_PROXY_ENVIRONMENT": "preview",
      "PROXY_LOG_LEVEL": "debug",
    },
    "version_metadata": { "binding": "EVIEWER_VERSION" },
    "ratelimits": [
      { "name": "proxy-df", "namespace_id": "3", "simple": { "limit": 10, "period": 10 } },
    ],
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "redact_query_string": true,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true,
      },
      "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
      "issues": { "enabled": true },
    },
  },
}
