{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eproxy",
  "main": "../../proxy-server.workers.js",
  // Preserve the existing production runtime during the CI/CD migration.
  "compatibility_date": "2025-10-19",
  "compatibility_flags": [
    "enable_nodejs_process_v2",
    "enable_nodejs_http_server_modules",
    "enable_nodejs_http_modules",
    "nodejs_compat_populate_process_env"
  ],
  // This standalone proxy has no imports. Upload only its entry point.
  "no_bundle": true,
  "find_additional_modules": false,
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "ALLOWED_AUTH_EXPORT_ORIGINS": "https://viewer.example.com,https://viewer.example.com"
  },
  "routes": [{ "pattern": "proxy.example.com", "custom_domain": true }],
  "placement": { "mode": "smart" },
  "ratelimits": [
    {
      "name": "proxy-df",
      "namespace_id": "0",
      "simple": { "limit": 10, "period": 10 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "persist": true, "head_sampling_rate": 1 }
  }
}
